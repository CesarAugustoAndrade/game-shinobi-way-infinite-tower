{
  "name": "shinobi-way-infinite-tower",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@11.5.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "lint": "npm run lint:css",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "budget:dist": "node scripts/check-dist-budget.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run budget:dist",
    "simulate": "npx tsx src/simulation/index.ts",
    "simulate:quick": "npx tsx src/simulation/index.ts --quick",
    "simulate:progression": "npx tsx src/simulation/index.ts --progression",
    "simulate:progression:quick": "npx tsx src/simulation/index.ts --progression --quick",
    "simulate:campaign": "npx tsx src/simulation/index.ts --campaign",
    "simulate:campaign:quick": "npx tsx src/simulation/index.ts --campaign --quick"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "pngjs": "^7.0.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "tsx": "^4.19.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "ajv": "^8.18.0",
    "fast-uri": "^3.1.5",
    "flatted": "^3.4.4",
    "js-yaml": "^4.3.1",
    "micromatch": {
      "picomatch": "2.3.2"
    }
  }
}
